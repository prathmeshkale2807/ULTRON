# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real secrets.

# --- App ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Networking (local-only in Phase 1; Remote Mode is a later, separate
# security review) ------------------------------------------------------
HOST=127.0.0.1
PORT=8756

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/ultron.db

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# --- AI providers (NOT used yet -- Phase 2 wires these up) ---------------
# Fill in only the ones you plan to use. Never share these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
