# ULTRON Configuration
ENVIRONMENT=development
DEBUG=true

# --- Networking -------------------------------------------------------
HOST=127.0.0.1
PORT=8756

# --- Database ----------------------------------------------------------
DATABASE_URL=sqlite:///./data/ultron.db

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# --- AI providers ------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# --- Models ------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-3.6-flash

# --- Provider behavior -------------------------------------------------
AI_PROVIDER_TIMEOUT_SECONDS=30.0
AI_PROVIDER_MAX_RETRIES=2

AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=

AI_CLAUDE_AUTHORIZED_SENSITIVITIES=PUBLIC,INTERNAL,SENSITIVE,PRIVATE
AI_GEMINI_AUTHORIZED_SENSITIVITIES=PUBLIC,INTERNAL

# --- Voice -------------------------------------------------------------
VOICE_CONVERSATION_TIMEOUT_SECONDS=15.0

# --- Voice Live Settings -----------------------------------------------
ULTRON_LIVE_VOICE=charon
ULTRON_LIVE_MODEL=models/gemini-3.1-flash-live-preview
