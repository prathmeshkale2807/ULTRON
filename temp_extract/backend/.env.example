# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real secrets.

# --- App ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Networking (local-only in Phase 1; Remote Mode is a later, separate
# security review) ------------------------------------------------------
HOST=127.0.0.1
PORT=8756

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/ultron.db

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# --- AI providers (Phase 2) -----------------------------------------------
# Fill in only the ones you plan to use. Never share these.
# Get keys from: https://console.anthropic.com/ and https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Models used by each adapter.
CLAUDE_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-2.5-flash

# Per-call timeout and retry count (applies to every provider).
AI_PROVIDER_TIMEOUT_SECONDS=30.0
AI_PROVIDER_MAX_RETRIES=2

# Which provider is tried first, and which (if any) is tried on failure.
# Fallback is only ever used if it's ALSO authorized for the request's
# sensitivity -- see the *_AUTHORIZED_SENSITIVITIES vars below.
AI_PRIMARY_PROVIDER=claude
AI_FALLBACK_PROVIDER=gemini

# Comma-separated list of Sensitivity levels (PUBLIC, INTERNAL, SENSITIVE,
# PRIVATE) each provider is authorized to receive. Change these
# deliberately -- this is the privacy-routing policy, not a formality.
# Defaults: Claude cleared for everything; Gemini cleared for non-user-
# content only (PUBLIC/INTERNAL), so a Gemini failure never causes user
# file/email/private content to route there as a "fallback".
AI_CLAUDE_AUTHORIZED_SENSITIVITIES=PUBLIC,INTERNAL,SENSITIVE,PRIVATE
AI_GEMINI_AUTHORIZED_SENSITIVITIES=PUBLIC,INTERNAL
